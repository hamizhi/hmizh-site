SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
ADMIN_PASSWORD=replace-with-admin-password

# The public HTTPS origin of this site. Do not leave the old site's domain here.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Luckywood / Epay-compatible Alipay channel
LUCKYWOOD_PID=replace-with-luckywood-pid
LUCKYWOOD_KEY=replace-with-luckywood-merchant-key
LUCKYWOOD_API_BASE_URL=https://xrapi1.xymzf.cn/xpay/epay
# Optional; omit if Luckywood should choose the channel automatically.
LUCKYWOOD_CHANNEL_ID=

# ZovoCard public CDK redemption origin.
# Use https://sandbox.zovocard.com for sandbox testing, then switch to
# https://zovocard.com with production data.
ZOVOCARD_ORIGIN=https://sandbox.zovocard.com
